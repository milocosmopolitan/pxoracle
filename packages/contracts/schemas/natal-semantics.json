{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NatalSemantics",
  "type": "object",
  "properties": {
    "meanings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/NatalMeaning"
      }
    },
    "referenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "versions": {
      "$ref": "#/$defs/NatalVersions"
    }
  },
  "additionalProperties": false,
  "required": [
    "versions",
    "meanings",
    "referenceIds"
  ],
  "$defs": {
    "NatalMeaning": {
      "type": "object",
      "properties": {
        "fallback": {
          "type": "boolean"
        },
        "reference": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/NatalScope"
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NatalTopic"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "fallback",
        "reference",
        "themes",
        "topics"
      ]
    },
    "NatalScope": {
      "type": "string",
      "enum": [
        "personal",
        "social",
        "generational"
      ]
    },
    "NatalTopic": {
      "type": "string",
      "enum": [
        "self_emotions",
        "communication",
        "relationships",
        "action_work_growth"
      ]
    },
    "NatalVersions": {
      "type": "object",
      "properties": {
        "calculation": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "interpretation": {
          "type": "string"
        },
        "rules": {
          "type": "string"
        },
        "schema": {
          "type": "integer",
          "format": "uint32",
          "const": 1,
          "minimum": 0
        },
        "semantics": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema",
        "calculation",
        "interpretation",
        "semantics",
        "rules",
        "content"
      ]
    }
  }
}
