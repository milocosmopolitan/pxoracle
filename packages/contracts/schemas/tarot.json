      },
      "spread": {
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "state": {
        "type": "string"
      }
    },
    "required": [
      "schemaVersion",
      "engineVersion",
      "algorithm",
      "deckId",
      "contentVersion",
      "spread",
      "deck",
      "selections",
      "state"
