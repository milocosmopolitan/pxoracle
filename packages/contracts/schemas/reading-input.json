{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReadingInput",
  "type": "object",
  "properties": {
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RevealedCard"
      },
      "maxItems": 3,
      "minItems": 3
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "versions": {
      "$ref": "#/$defs/Versions"
    }
  },
  "additionalProperties": false,
  "required": [
    "versions",
    "context",
    "cards"
  ],
  "$defs": {
    "Context": {
      "type": "object",
      "properties": {
        "intent": {
          "$ref": "#/$defs/Intent"
        },
        "topic": {
          "$ref": "#/$defs/Topic"
        }
      },
      "additionalProperties": false,
      "required": [
        "topic",
        "intent"
      ]
    },
    "Intent": {
      "type": "string",
      "enum": [
        "present",
        "crossroads",
        "action"
      ]
    },
    "Orientation": {
      "type": "string",
      "enum": [
        "upright",
        "reversed"
      ]
    },
    "Position": {
      "type": "string",
      "enum": [
        "situation",
        "examination",
        "next_action"
      ]
    },
    "RevealedCard": {
      "type": "object",
      "properties": {
        "cardId": {
          "type": "string",
          "pattern": "^(major\\.(0[0-9]|1[0-9]|2[01])|(wands|cups|swords|pentacles)\\.(0[1-9]|1[0-4]))$"
        },
        "orientation": {
          "$ref": "#/$defs/Orientation"
        },
        "positionId": {
          "$ref": "#/$defs/Position"
        }
      },
      "additionalProperties": false,
      "required": [
        "cardId",
        "orientation",
        "positionId"
      ]
    },
    "Topic": {
      "type": "string",
      "enum": [
        "relationships",
        "work",
        "creativity",
        "growth"
      ]
    },
    "Versions": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "const": "reading.en.1"
        },
        "engine": {
          "type": "string",
          "const": "reading.1"
        },
        "rules": {
          "type": "string",
          "const": "rules.1"
        },
        "schema": {
          "type": "integer",
          "format": "uint32",
          "const": 1,
          "minimum": 0
        },
        "semantics": {
          "type": "string",
          "const": "semantics.1"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema",
        "engine",
        "semantics",
        "rules",
        "content"
      ]
    }
  }
}
