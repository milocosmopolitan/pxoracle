{
  "name": "pxoracle",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "npm run dev -w @pxoracle/web",
    "build": "npm run build -w @pxoracle/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "storybook": "npm run storybook -w @pxoracle/web",
    "build-storybook": "npm run build-storybook -w @pxoracle/web",
    "test": "node --import tsx --test tests/*.test.mjs",
    "wasm": "bash scripts/build-wasm.sh",
    "reading-export": "node --import tsx scripts/reading-export/cli.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.183.1",
    "ajv": "8.17.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
